# Copia este archivo como .env.local y llena los datos de tu proyecto de Firebase
# (Configuración del proyecto -> General -> Tus apps -> Configuración del SDK).
# Sin estos valores la app funciona solo en modo demostración.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_DATABASE_URL=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
# Dispositivo que se muestra por defecto (debe coincidir con DEVICE_ID del firmware).
VITE_DEFAULT_DEVICE_ID=croak-01
